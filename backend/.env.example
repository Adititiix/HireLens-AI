PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/resumeiq
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
NLP_SERVICE_URL=http://localhost:8000
MAX_FILE_SIZE_MB=10
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase project ID used to verify Google sign-in tokens (same value as VITE_FIREBASE_PROJECT_ID in frontend/.env).
# Not a secret. A service-account key is NOT required just to verify sign-ins.
FIREBASE_PROJECT_ID=your-firebase-project-id
